{
  "name": "Team Mex — Mantenimiento",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "API",
      "command": "bash .cursor/wait-for-db.sh && bash script/dev-local.sh api",
      "description": "NestJS API on http://localhost:3001 (Swagger at /docs)."
    },
    {
      "name": "Web",
      "command": "bash script/dev-local.sh web",
      "description": "Next.js UI on http://localhost:3000 (proxies /backend to the API)."
    }
  ],
  "ports": [
    {
      "name": "web",
      "port": 3000
    },
    {
      "name": "api",
      "port": 3001
    }
  ]
}
