# Local / Docker: variables sueltas.
DB_HOST=localhost
DB_PORT=5432
DB_USER=team_mex
DB_PASSWORD=team_mex
DB_NAME=team_mex_mtto
# Railway: pegue DATABASE_URL del plugin Postgres (pisa DB_*).
# DATABASE_URL=postgresql://user:pass@host:5432/railway
# SSL: auto en hosts públicos; *.railway.internal y localhost van sin SSL.
# DB_SSL=true
# DB_SSL=false
HOST=0.0.0.0
PORT=3001
# Lista separada por comas, o * para reflejar cualquier origen (red local / Docker).
# En prod: URL de Vercel, p. ej. https://su-app.vercel.app
CORS_ORIGIN=http://localhost:3000

# Andon outbound. Default noop. MUST 1–3 do not depend on WhatsApp.
# ANDON_NOTIFY_PROVIDER=noop
# ANDON_NOTIFY_PROVIDER=evolution
# EVOLUTION_BASE_URL=                 # e.g. http://localhost:8080
# EVOLUTION_API_KEY=
# EVOLUTION_INSTANCE=
# ANDON_WA_GROUP_JID=                 # 1203...@g.us  throwaway Baileys, ToS risk, not prod
# When PROVIDER=evolution: POST {EVOLUTION_BASE_URL}/message/sendText/{EVOLUTION_INSTANCE}
#   body: { "number": "<ANDON_WA_GROUP_JID>", "text": "..." }
# Evolution+Baileys is demo/lab only (ToS risk / ban). Throwaway number. NOT prod.
