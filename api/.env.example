DB_HOST=localhost
DB_PORT=5432
DB_USER=team_mex
DB_PASSWORD=team_mex
DB_NAME=team_mex_mtto
# Railway / Supabase: pegue DATABASE_URL (tiene prioridad sobre DB_*).
# DATABASE_URL=postgresql://postgres:pass@postgres.railway.internal:5432/railway
# TLS: auto en *.rlwy.net / *.supabase.co. Forzar: DB_SSL=true|false
# DB_SSL=true
HOST=0.0.0.0
PORT=3001
# Lista separada por comas, o * para reflejar cualquier origen (red local / Docker / Vercel).
CORS_ORIGIN=http://localhost:3000

# OIDC real: configurar para staging/producción; sin fallback a X-Role.
# AUTH_MODE=OIDC
# AUTH_OIDC_ISSUER=https://ISSUER_REAL
# AUTH_OIDC_AUDIENCE=https://api.team-mex-mtto
# AUTH_OIDC_JWKS_URL=https://URL_JWKS_REAL
# AUTH_OIDC_ACTORS={}  # mapping server-side subject -> displayName/roles/facilityScopes
# Configuración y requisitos: docs/design/auth-web-staging.md

# Andon outbound. Default noop. MUST 1–3 do not depend on WhatsApp.
# ANDON_NOTIFY_PROVIDER=noop
# ANDON_NOTIFY_PROVIDER=evolution
# EVOLUTION_BASE_URL=                 # e.g. http://localhost:8080
# EVOLUTION_API_KEY=
# EVOLUTION_INSTANCE=
# ANDON_WA_GROUP_JID=                 # 1203...@g.us  throwaway Baileys, ToS risk, not prod
# When PROVIDER=evolution: POST {EVOLUTION_BASE_URL}/message/sendText/{EVOLUTION_INSTANCE}
#   body: { "number": "<ANDON_WA_GROUP_JID>", "text": "..." }
# Evolution+Baileys is demo/lab only (ToS risk / ban). Throwaway number. NOT prod.
# User administration: explicit persistent directory, no config fallback.
# AUTH_ACTOR_STORE=DATABASE
# Bootstrap AUTH_OIDC_ACTORS only when directory for the issuer is empty.
# Requires at least one ADMIN_DIRECTIVO and existing facility IDs.
# AUTH_MIGRATION_DATABASE=<exact database name for auth:migration:up>

# Controlled release (separate runner; never enable synchronize/drop in production).
# DB_SYNCHRONIZE=false
# DB_DROP_SCHEMA=false
# CHECK_MIGRATION_DATABASE=<exact effective database name>
# CHK_LEGACY_WRITERS_DRAINED=true  # only after stopping every old writer
# CHECK_MIGRATION_WITHOUT_BACKUP=ACKNOWLEDGED
# Procedure: docs/migrations/railway-check-auth-release.md
