# URL de API para proxy del servidor. Producción requiere HTTPS y valor explícito.
# Guía de despliegue: DEPLOY.md. API_URL se lee en servidor; sin fallback público.
API_URL=http://localhost:3001
# Desarrollo local sin OIDC conserva acceso de prueba; nunca en producción.
# WEB_AUTH_MODE=OIDC
# AUTH_APP_ORIGIN=https://DOMINIO_STAGING
# AUTH_OIDC_ISSUER=https://ISSUER_REAL
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=
# AUTH_OIDC_AUDIENCE=https://api.team-mex-mtto  # Auth0: idéntico al de api/
# AUTH_OIDC_SCOPE=openid profile
# AUTH_SESSION_SECRET=  # 32 bytes aleatorios en base64, secreto del servidor
# Configuración y requisitos: docs/design/auth-web-staging.md
# Configuración Auth0 elegida: docs/design/auth0-staging.md
