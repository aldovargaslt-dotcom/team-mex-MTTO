  "queries": {
    "tables": "select table_schema,table_name from information_schema.tables where table_schema not in ('information_schema','pg_catalog') order by 1,2",
    "columns": "select table_schema,table_name,column_name,data_type from information_schema.columns where (table_schema='public' and table_name in ('visitas','unidades','visita_trabajos','visita_piezas','visita_fotos','visita_firmas','outbox_events')) or (table_schema='inventario' and table_name in ('movimientos','pendientes_comprobante','stock')) order by 1,2,ordinal_position",
    "visits": "select id,unidad_id,estado,km,tipo,observaciones,cerrado_at,created_at,updated_at from public.visitas",
    "units": "select id,numero_interno,placas,estado,tipo_id from public.unidades order by numero_interno",
    "works": "select visita_id,categoria,item from public.visita_trabajos",
    "pieces": "select visita_id,item_id,qty,origen from public.visita_piezas",
    "photos": "select visita_id,count(*)::int as count from public.visita_fotos group by visita_id",
    "signatures": "select visita_id,tipo,length(data_url)::int as bytes from public.visita_firmas",
    "outbox": "select id,type,payload->>'visitaId' as visita_id,payload->>'unidadId' as unidad_id,payload->>'km' as km,payload->'consumos' as consumos,processed_at,created_at from public.outbox_events",
    "movements": "select tipo,qty,delta,visita_id,item_id,created_at from inventario.movimientos",
    "pending": "select visita_id,item_id,qty,estado,(ticket_data_url is not null) as has_evidence from inventario.pendientes_comprobante",
    "stock": "select item_id,qty,min_qty,updated_at from inventario.stock"
  },
